# Lokalnie ustaw własny login i hasło, następnie uruchom npm run admin:prepare.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
SITE_ORIGIN=https://zabki.vercel.app
# Sekret połączenia PostgreSQL w Supabase (Transaction pooler, port 6543), wyłącznie po stronie serwera.
DATABASE_URL=""
# Opcjonalny Session pooler (5432) do migracji; domyślnie używa DATABASE_URL.
DATABASE_MIGRATION_URL=""
# W Vercelu ustaw wartości z lokalnego .env.admin oraz DATABASE_URL.
ADMIN_PASSWORD_HASH=""
ADMIN_SECRET_KEY=""
