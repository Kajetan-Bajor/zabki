{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev --no-audit --no-fund",
  "buildCommand": "node scripts/build-vercel-proxy.mjs",
  "outputDirectory": "vercel-output",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/((?:admin(?:/.*)?|api/blog/?|media/.*))$",
      "dest": "/api/vercel-proxy?__site_path=$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/vercel-site?__site_path=$1"
    }
  ]
}
